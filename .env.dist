# Chemins hôte alignés à l'identique dans le conteneur benchy : le dashboard
# lance des conteneurs sandbox via le daemon Docker de l'hôte (docker-out-of-
# docker), qui ne sait monter que des chemins hôte. app/bundle/output/workspace
# vivent sous BENCHY_PROJECTS_ROOT ; les creds OAuth sous BENCHY_CLAUDE_DIR.
BENCHY_PROJECTS_ROOT=/Users/keyxmare/Projects
BENCHY_CLAUDE_DIR=/Users/keyxmare/.claude
BENCHY_ROOT=/Users/keyxmare/Projects/github.com/keyxmare/claude-benchy
