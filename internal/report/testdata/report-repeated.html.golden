<td class="lvl na"><span class="obs">$0.5000</span></td>
<td class="lvl na"><span class="obs">$0.5000</span></td>
<td class="lvl na"><span class="obs">$0.5000</span></td>
<td class="lvl na"><span class="obs">$0.5000</span></td>
</tr>
